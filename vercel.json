{
  "version": 2,
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist/client",
  "framework": "vite",
  "crons": [
    {
      "path": "/api/cron/cleanup-messages",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/targets",
      "destination": "https://eye-radar.onrender.com/api/targets"
    },
    {
      "source": "/api/tracks",
      "destination": "https://eye-radar.onrender.com/api/tracks"
    },
    {
      "source": "/api/tracks/:match*",
      "destination": "https://eye-radar.onrender.com/api/tracks/:match*"
    },
    {
      "source": "/api/config",
      "destination": "https://eye-radar.onrender.com/api/config"
    },
    {
      "source": "/api/alerts",
      "destination": "https://eye-radar.onrender.com/api/alerts"
    },
    {
      "source": "/api/alerts/:match*",
      "destination": "https://eye-radar.onrender.com/api/alerts/:match*"
    },
    {
      "source": "/api/report",
      "destination": "https://eye-radar.onrender.com/api/report"
    },
    {
      "source": "/api/impacts",
      "destination": "https://eye-radar.onrender.com/api/impacts"
    },
    {
      "source": "/api/status",
      "destination": "https://eye-radar.onrender.com/api/status"
    },
    {
      "source": "/api/drill",
      "destination": "https://eye-radar.onrender.com/api/drill"
    },
    {
      "source": "/api/drill/:match*",
      "destination": "https://eye-radar.onrender.com/api/drill/:match*"
    },
    {
      "source": "/api/replay",
      "destination": "https://eye-radar.onrender.com/api/replay"
    },
    {
      "source": "/api/sources",
      "destination": "https://eye-radar.onrender.com/api/sources"
    },
    {
      "source": "/api/sources-test",
      "destination": "https://eye-radar.onrender.com/api/sources-test"
    },
    {
      "source": "/api/wind",
      "destination": "https://eye-radar.onrender.com/api/wind"
    },
    {
      "source": "/api/thermal",
      "destination": "https://eye-radar.onrender.com/api/thermal"
    },
    {
      "source": "/api/telemetry",
      "destination": "https://eye-radar.onrender.com/api/telemetry"
    },
    {
      "source": "/api/ai/:match*",
      "destination": "https://eye-radar.onrender.com/api/ai/:match*"
    },
    {
      "source": "/api/briefing",
      "destination": "https://eye-radar.onrender.com/api/briefing"
    },
    {
      "source": "/api/location/:match*",
      "destination": "https://eye-radar.onrender.com/api/location/:match*"
    },
    {
      "source": "/health",
      "destination": "https://eye-radar.onrender.com/health"
    },
    {
      "source": "/avatar.jpg",
      "destination": "https://eye-radar.onrender.com/avatar.jpg"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|health|ws|avatar\\.jpg|assets/|.*\\.(?:geojson|json|js|css|svg|png|jpg|jpeg|ico|webmanifest)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(app.*|.*html|$)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS, HEAD"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https: data: blob: wss:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://telegram.org; style-src 'self' 'unsafe-inline' https:; img-src 'self' https: data: blob:; connect-src 'self' https: wss:; worker-src 'self' blob:; font-src 'self' https: data:;"
        }
      ]
    }
  ]
}