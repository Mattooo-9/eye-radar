{
  "version": 2,
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist/client",
  "framework": "vite",
  "crons": [
    {
      "path": "/api/cron/cleanup-messages",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/targets",
      "destination": "https://eye-radar.onrender.com/api/targets"
    },
    {
      "source": "/api/impacts",
      "destination": "https://eye-radar.onrender.com/api/impacts"
    },
    {
      "source": "/api/drill",
      "destination": "https://eye-radar.onrender.com/api/drill"
    },
    {
      "source": "/api/replay",
      "destination": "https://eye-radar.onrender.com/api/replay"
    },
    {
      "source": "/api/sources",
      "destination": "https://eye-radar.onrender.com/api/sources"
    },
    {
      "source": "/health",
      "destination": "https://eye-radar.onrender.com/health"
    },
    {
      "source": "/avatar.jpg",
      "destination": "https://eye-radar.onrender.com/avatar.jpg"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|health|ws|avatar\\.jpg|assets/|.*\\.(?:geojson|json|js|css|svg|png|jpg|jpeg|ico|webmanifest)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(app.*|.*html|$)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS, HEAD"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        },
        {
          "key": "Content-Security-Policy",
          "value": "worker-src 'self'"
        }
      ]
    }
  ]
}